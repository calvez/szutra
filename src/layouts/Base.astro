---
import '../styles/global.css';
interface Props { title?: string; description?: string; lang?: 'hu' | 'en'; }
const { title, description = 'Onedropzendo Szútrakönyv – Sesshin szútrák, dharánik és étkezési szútrák magyarul és angolul, gong-jelzésekkel.', lang = 'hu' } = Astro.props;
const full = title ? `${title} – Szútrakönyv` : 'Szútrakönyv – Onedropzendo';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#efe9dc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
    <meta property="og:type" content="book" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
